# StreamHub Platform Environment Configuration
# Copy this file to .env for local deployment

# --- Runtime & Application ---
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
JWT_SECRET="streamhub-ultra-secure-jwt-signing-secret-256bit-min"
JWT_EXPIRES_IN="7d"

# --- PostgreSQL Database ---
# Local Docker or Cloud SQL / RDS
DATABASE_URL="postgresql://streamhub:streamhub_secret@localhost:5432/streamhub_db?schema=public"
POSTGRES_USER="streamhub"
POSTGRES_PASSWORD="streamhub_secret"
POSTGRES_DB="streamhub_db"

# --- Redis Cache & BullMQ Queue ---
# Used for job queues, view deduplication sets, and batched counter flushes
REDIS_URL="redis://localhost:6379"

# --- S3 / MinIO Object Storage ---
# For local dev: MinIO running on port 9000
# For production: AWS S3 or Cloudflare R2
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_URL="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin123"
S3_FORCE_PATH_STYLE="true"

# Storage Bucket Names
S3_BUCKET_RAW="streamhub-raw"
S3_BUCKET_HLS="streamhub-hls"
S3_BUCKET_THUMBNAILS="streamhub-thumbnails"

# --- Video Ingestion & Processing Limits ---
MAX_UPLOAD_SIZE_MB=2048
ALLOWED_VIDEO_MIME_TYPES="video/mp4,video/quicktime,video/webm,video/x-matroska"
HLS_SEGMENT_DURATION_SECONDS=4

# --- Rate Limiting & Security ---
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=120
VIEW_DEDUP_WINDOW_HOURS=24
MIN_WATCH_PERCENTAGE_FOR_VIEW=50
MIN_WATCH_SECONDS_FOR_VIEW=30
